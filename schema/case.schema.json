{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanrecord.example.org/schema/case.schema.json",
  "title": "The Human Record canonical case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "record_classification",
    "identity",
    "historical_timeline",
    "claims",
    "sources",
    "synthetic_episode",
    "clinical",
    "care_plan",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^HR-[A-Z0-9]+$"
    },
    "record_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "banner",
        "real_historical_name",
        "public_release_status"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "banner": {
          "const": "SYNTHETIC RECORD, NOT A REAL MEDICAL RECORD"
        },
        "real_historical_name": {
          "const": true
        },
        "public_release_status": {
          "enum": [
            "draft",
            "review",
            "approved",
            "withheld"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "display_name",
        "sex",
        "era",
        "nationality",
        "historical_dates",
        "synthetic_identity"
      ],
      "properties": {
        "person_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sex": {
          "enum": [
            "female",
            "male",
            "intersex",
            "unknown",
            "not_recorded"
          ]
        },
        "era": {
          "description": "Roster era, used for dataset balance reporting.",
          "enum": [
            "Ancient & Classical",
            "Renaissance & Early Modern",
            "Enlightenment",
            "19th Century",
            "Early 20th Century",
            "Mid-Late 20th Century",
            "Not applicable"
          ]
        },
        "nationality": {
          "description": "Roster nationality, as recorded in the master roster.",
          "type": "string",
          "minLength": 1
        },
        "historical_dates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "birth",
            "death"
          ],
          "properties": {
            "birth": {
              "$ref": "#/$defs/historicalDateAssertion"
            },
            "death": {
              "$ref": "#/$defs/historicalDateAssertion"
            }
          }
        },
        "synthetic_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mrn",
            "ssn",
            "date_of_birth",
            "name_policy",
            "fictional_facility",
            "fictional_primary_clinician",
            "fictional_consultant"
          ],
          "properties": {
            "mrn": {
              "type": "string",
              "pattern": "^HR-[A-Z0-9-]+-SYN$"
            },
            "ssn": {
              "description": "Made-up Social Security number. The 000 area number is never issued, so it cannot belong to a real person.",
              "type": "string",
              "pattern": "^000-[0-9]{2}-[0-9]{4}$"
            },
            "date_of_birth": {
              "type": "string",
              "format": "date"
            },
            "name_policy": {
              "const": "real_historical_name"
            },
            "fictional_facility": {
              "type": "string"
            },
            "fictional_primary_clinician": {
              "type": "string"
            },
            "fictional_consultant": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "specialty"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "specialty": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "historical_timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "date",
          "summary",
          "claim_ids"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^EVT-[0-9]{4}$"
          },
          "date": {
            "$ref": "#/$defs/historicalDate"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "synthetic_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_frame",
        "index_date",
        "index_age",
        "date_shift_policy",
        "visit_schedule"
      ],
      "properties": {
        "calendar_frame": {
          "description": "Canonical cases are modern_shifted. true_date appears only in cases derived by scripts/derive_true_date_case.mjs.",
          "enum": [
            "modern_shifted",
            "true_date"
          ]
        },
        "index_date": {
          "type": "string",
          "format": "date"
        },
        "index_age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 125
        },
        "date_shift_policy": {
          "const": "HR-DATE-SHIFT-1"
        },
        "teaching_objective": {
          "type": "string"
        },
        "visit_schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "encounter_id",
              "date",
              "purpose"
            ],
            "properties": {
              "encounter_id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "clinical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problems",
        "medications",
        "allergies",
        "observations",
        "procedures",
        "immunizations",
        "family_history",
        "past_medical_history",
        "encounters",
        "vital_sign_sets",
        "social_history",
        "functional_status",
        "mental_status"
      ],
      "properties": {
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalProblem"
          }
        },
        "medications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/medication"
          }
        },
        "allergies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/allergy"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/procedure"
          }
        },
        "immunizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/immunization"
          }
        },
        "family_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/familyHistory"
          }
        },
        "past_medical_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pastMedicalHistory"
          }
        },
        "encounters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "vital_sign_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vitalSignSet"
          }
        },
        "social_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "functional_status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "mental_status": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "safety_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "date",
            "current_ideation",
            "intent",
            "plan",
            "access_reviewed",
            "protective_factors",
            "disposition",
            "provenance"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "current_ideation": {
              "enum": [
                "present",
                "absent",
                "unknown"
              ]
            },
            "intent": {
              "enum": [
                "present",
                "absent",
                "unknown"
              ]
            },
            "plan": {
              "enum": [
                "present",
                "absent",
                "unknown"
              ]
            },
            "access_reviewed": {
              "type": "boolean"
            },
            "protective_factors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disposition": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            }
          },
          "description": "Structured present-day suicide and self-harm risk assessment. Validation requires it when the episode has a behavioral-health problem or a positive depression screen."
        }
      }
    },
    "care_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "health_concerns",
        "goals",
        "interventions",
        "guidelines"
      ],
      "properties": {
        "health_concerns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "interventions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clinicalElement"
          }
        },
        "guidelines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guideline"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validation",
        "clinical_review",
        "provenance_review",
        "safe_messaging_review"
      ],
      "properties": {
        "schema_validation": {
          "$ref": "#/$defs/reviewStatus"
        },
        "clinical_review": {
          "$ref": "#/$defs/reviewStatus"
        },
        "provenance_review": {
          "$ref": "#/$defs/reviewStatus"
        },
        "safe_messaging_review": {
          "$ref": "#/$defs/reviewStatus"
        }
      }
    }
  },
  "$defs": {
    "evidenceGrade": {
      "enum": [
        "D",
        "R",
        "S"
      ]
    },
    "historicalDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "precision",
        "calendar"
      ],
      "properties": {
        "iso": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?[0-9]{4,6}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "display": {
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "decade",
            "approximate",
            "unknown"
          ]
        },
        "calendar": {
          "enum": [
            "gregorian",
            "julian",
            "proleptic_gregorian",
            "unknown"
          ]
        }
      }
    },
    "historicalDateAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred",
        "alternatives"
      ],
      "properties": {
        "preferred": {
          "$ref": "#/$defs/historicalDate"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "source_ids",
              "resolution_status"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/historicalDate"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "resolution_status": {
                "enum": [
                  "preferred",
                  "conflicting",
                  "superseded",
                  "unresolved"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "evidence_grade",
        "certainty",
        "source_links",
        "release_status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLM-[0-9]{4}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_grade": {
          "$ref": "#/$defs/evidenceGrade"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "probable",
            "possible",
            "disputed",
            "synthetic"
          ]
        },
        "clinical_interpretation": {
          "type": "string"
        },
        "source_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "relationship"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "relationship": {
                "enum": [
                  "supports",
                  "disputes",
                  "context",
                  "derived_from"
                ]
              },
              "locator": {
                "type": "string"
              }
            }
          }
        },
        "release_status": {
          "enum": [
            "draft",
            "reviewed",
            "approved",
            "withheld"
          ]
        },
        "sensitive_content": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "url",
        "source_type",
        "accessed"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{4}$"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "enum": [
            "primary",
            "government",
            "scholarly",
            "biography",
            "guideline",
            "standard",
            "other"
          ]
        },
        "published": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed": {
          "type": "string",
          "format": "date"
        },
        "rights_note": {
          "type": "string"
        }
      }
    },
    "coding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code",
        "display"
      ],
      "properties": {
        "system": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "unvalidated",
            "validated",
            "invalid",
            "deprecated"
          ]
        },
        "validated_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_grade",
        "claim_ids",
        "synthetic_reason"
      ],
      "properties": {
        "evidence_grade": {
          "$ref": "#/$defs/evidenceGrade"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "synthetic_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "clinicalElement": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "display",
        "status",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "coding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "vitalSignSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "measurements",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "display",
              "value",
              "unit"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "display": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "clinicalProblem": {
      "allOf": [
        {
          "$ref": "#/$defs/clinicalElement"
        },
        {
          "type": "object",
          "required": [
            "clinical_status",
            "verification_status",
            "problem_placement"
          ],
          "properties": {
            "clinical_status": {
              "enum": [
                "active",
                "resolved",
                "inactive",
                "remission",
                "unknown"
              ]
            },
            "verification_status": {
              "enum": [
                "confirmed",
                "provisional",
                "differential",
                "refuted",
                "entered-in-error"
              ]
            },
            "problem_placement": {
              "enum": [
                "active",
                "historical",
                "both_with_link"
              ]
            },
            "recorded_date": {
              "type": "string",
              "format": "date",
              "description": "Visit date at which the diagnosis was made. Earlier visits' documents do not list the problem. Omit for problems known at the index visit."
            }
          }
        }
      ]
    },
    "guideline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guideline_id",
        "title",
        "publisher",
        "url",
        "version_or_year"
      ],
      "properties": {
        "guideline_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version_or_year": {
          "type": "string"
        }
      }
    },
    "reviewStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "medication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display",
        "status",
        "coding",
        "dose",
        "route",
        "frequency",
        "start_date",
        "indication_problem_ids",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "completed",
            "stopped",
            "on-hold"
          ]
        },
        "coding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          },
          "minItems": 1,
          "description": "RxNorm clinical drug; era remedies map to a modern equivalent."
        },
        "dose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": "string",
              "description": "UCUM"
            }
          }
        },
        "route": {
          "enum": [
            "oral",
            "sublingual",
            "topical",
            "intramuscular",
            "subcutaneous",
            "intravenous",
            "inhalation",
            "nasal",
            "ophthalmic",
            "intravitreal"
          ]
        },
        "frequency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "period_unit",
            "text"
          ],
          "properties": {
            "period": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "period_unit": {
              "enum": [
                "h",
                "d",
                "wk"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "indication_problem_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "historical_remedy": {
          "type": "string",
          "description": "Era remedy this entry maps from, for example laudanum."
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "allergy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display",
        "status",
        "assertion",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "resolved"
          ]
        },
        "assertion": {
          "enum": [
            "no_known_allergy",
            "allergy",
            "intolerance"
          ]
        },
        "substance": {
          "$ref": "#/$defs/coding"
        },
        "reaction": {
          "$ref": "#/$defs/coding"
        },
        "criticality": {
          "enum": [
            "low",
            "high",
            "unable-to-assess"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "if": {
        "properties": {
          "assertion": {
            "enum": [
              "allergy",
              "intolerance"
            ]
          }
        }
      },
      "then": {
        "required": [
          "substance"
        ]
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display",
        "status",
        "coding",
        "period",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "in-progress"
          ]
        },
        "coding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          },
          "minItems": 1
        },
        "period": {
          "$ref": "#/$defs/period"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "immunization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display",
        "status",
        "coding",
        "date",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed"
          ]
        },
        "coding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          },
          "minItems": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "familyHistory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Real relatives of real people: only documented or retrospective content, never synthetic.",
      "required": [
        "id",
        "relationship",
        "condition",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/coding"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "condition_coding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coding"
          }
        },
        "age_at_death": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "type": "object",
              "properties": {
                "evidence_grade": {
                  "enum": [
                    "D",
                    "R"
                  ]
                },
                "claim_ids": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      }
    },
    "pastMedicalHistory": {
      "type": "object",
      "additionalProperties": false,
      "description": "True biography. Dates are historical and never enter the synthetic timeline.",
      "required": [
        "id",
        "display",
        "historical_date",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "historical_date": {
          "$ref": "#/$defs/historicalDate"
        },
        "provenance": {
          "allOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "type": "object",
              "properties": {
                "evidence_grade": {
                  "enum": [
                    "D",
                    "R"
                  ]
                },
                "claim_ids": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      }
    },
    "observation": {
      "description": "A scored instrument (survey, the default), a laboratory result, or an imaging measurement. Laboratory and imaging results need a reference range and an interpretation flag; results drawn together share a panel.",
      "allOf": [
        {
          "$ref": "#/$defs/clinicalElement"
        }
      ],
      "required": [
        "effective_date",
        "value",
        "unit",
        "coding"
      ],
      "properties": {
        "category": {
          "enum": [
            "survey",
            "laboratory",
            "imaging"
          ]
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "reference_range": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "interpretation": {
          "enum": [
            "N",
            "H",
            "L",
            "HH",
            "LL",
            "A"
          ]
        },
        "panel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "display"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "display": {
              "type": "string"
            }
          }
        },
        "label": {
          "type": "string",
          "description": "Short clinical name used in note prose, such as ALT or HbA1c."
        }
      },
      "if": {
        "properties": {
          "category": {
            "enum": [
              "laboratory",
              "imaging"
            ]
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "required": [
          "reference_range",
          "interpretation"
        ]
      }
    }
  }
}
