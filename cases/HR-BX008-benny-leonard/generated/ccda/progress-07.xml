    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Cardiovascular</td><td>Negative</td><td>No chest discomfort, palpitations, fainting or breathlessness at work</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No indigestion, black stools or bleeding</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; less worry; sleeping six to seven hours</td></tr></tbody></table><paragraph>3 systems reviewed. [S]</paragraph></text>

  </section>
</component>

