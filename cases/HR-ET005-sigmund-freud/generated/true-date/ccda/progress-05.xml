    <title>Medications</title>
    <text><table><thead><tr><th>Medication</th><th>Frequency</th><th>Route</th><th>Dates</th><th>Status</th><th>Evidence</th></tr></thead><tbody><tr ID="medication-1"><td>Varenicline 0.5 mg oral tablet: one tablet daily for three days, then one tablet twice daily for four days</td><td>One tablet daily for three days, then twice daily for four days, after food</td><td>Oral route</td><td>1930-06-01 to 1930-06-08</td><td>completed</td><td>S</td></tr><tr ID="medication-2"><td>Varenicline 1 mg oral tablet, one tablet twice daily after food; planned for at least 24 weeks</td><td>One tablet twice daily after food</td><td>Oral route</td><td>1930-06-08</td><td>active</td><td>S</td></tr><tr ID="medication-3"><td>Nicotine 21 mg/24 hours transdermal patch, one patch each morning from the quit date, for six weeks</td><td>One patch each morning</td><td>Topical route</td><td>1930-07-20 to 1930-08-31</td><td>completed</td><td>S</td></tr><tr ID="medication-4"><td>Nicotine 14 mg/24 hours transdermal patch, one patch each morning for four weeks, then stop</td><td>One patch each morning</td><td>Topical route</td><td>1930-08-31 to 1930-09-28</td><td>completed</td><td>S</td></tr><tr ID="medication-5"><td>Nicotine 4 mg oral lozenge, one lozenge as needed for cravings, up to 10 a day, dissolved on the side away from the obturator; gum avoided because it sticks to the prosthesis</td><td>One lozenge as needed, up to 10 a day</td><td>Oral route</td><td>1930-07-20</td><td>active</td><td>S</td></tr><tr ID="medication-6"><td>Acetaminophen 500 mg oral tablet, two tablets three times daily (3,000 mg a day) for pain at the maxillectomy site</td><td>Two tablets three times daily</td><td>Oral route</td><td>1930-06-01</td><td>active</td><td>S</td></tr><tr ID="medication-7"><td>Nystatin 100,000 units/mL oral suspension, 5 mL swished around the mouth and defect for as long as possible and then swallowed, four times daily with the obturator out, for 14 days</td><td>5 mL four times daily for 14 days</td><td>Oral route</td><td>1930-09-14 to 1930-09-28</td><td>completed</td><td>S</td></tr></tbody></table></text>

