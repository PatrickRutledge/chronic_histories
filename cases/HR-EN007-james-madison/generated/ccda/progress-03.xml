    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight 54.6 kg; no fever</td></tr><tr><td>Neurological</td><td>Positive</td><td>Three typical events; no new kinds of event, injury, or tongue biting</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Low mood in the mornings and much worry; sleep about six and a half hours; no suicidal thoughts</td></tr></tbody></table><paragraph>3 systems reviewed. [S]</paragraph></text>

  </section>
</component>

