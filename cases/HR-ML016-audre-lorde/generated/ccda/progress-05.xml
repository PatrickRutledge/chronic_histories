    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; no fever, night sweats, or unexplained tiredness</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision; no floaters</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No hearing change or mouth sores</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, or leg swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Breast</td><td>Negative</td><td>No lump, pain, or skin change in the left breast or on the right chest wall</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Regular bowels; no blood in the stool</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No abnormal vaginal bleeding, discharge, or pelvic pain; no urinary symptoms</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No bone pain; full use of the right arm</td></tr><tr><td>Integumentary</td><td>Negative</td><td>Mastectomy scar comfortable; no new skin lesions</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headaches or numbness</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 score 0</td></tr><tr><td>Endocrine</td><td>Positive</td><td>Mild hot flashes, one or two a day; one wakes her about once a week</td></tr></tbody></table><paragraph>13 systems reviewed. [S]</paragraph></text>

  </section>
</component>

