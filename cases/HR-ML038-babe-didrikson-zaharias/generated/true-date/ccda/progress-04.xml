    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Low fever; tired for about two weeks, before the cold began</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Sore throat and runny nose</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Dry cough; no breathlessness on exertion, wheeze or blood in the sputum</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations or leg swelling</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Bowel movements normal; no blood, diarrhea or abdominal pain</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No rash or itching</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No cold intolerance, weight change or thirst</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Annoyed at missing a round; no thoughts of self-harm</td></tr></tbody></table><paragraph>8 systems reviewed. [S]</paragraph></text>

