    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever or night sweats; weight rising</td></tr><tr><td>Eyes</td><td>Negative</td><td>No vision change apart from reading glasses</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>New dentures; one sore spot, easing since an adjustment two days ago; no hearing loss</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations or leg swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No difficulty swallowing, abdominal pain, change in bowel habit or blood in the stool</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No urinary symptoms</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No joint pain limiting activity</td></tr><tr><td>Integumentary</td><td>Negative</td><td>Old facial pockmarks unchanged; no new or changing skin lesions</td></tr><tr><td>Neurological</td><td>Negative</td><td>No weakness, numbness or headaches</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 0</td></tr></tbody></table><paragraph>11 systems reviewed. [S]</paragraph></text>

