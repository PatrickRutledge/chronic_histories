    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever; weight back up by 1.4 kg since the seizure</td></tr><tr><td>Eyes</td><td>Negative</td><td>No vision change; no glasses</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No hearing change; no tongue or mouth injury</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations or fainting with exertion</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Appetite better; no stomach pain or black stools on naproxen</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No urinary symptoms</td></tr><tr><td>Musculoskeletal</td><td>Positive</td><td>Mild low back ache, 2 out of 10</td></tr><tr><td>Integumentary</td><td>Negative</td><td>Training abrasions on the shins; no worrying moles</td></tr><tr><td>Neurological</td><td>Negative</td><td>No seizures, staring spells, sudden jerks on waking, numbness or weakness</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood steady; PHQ-2 score 0</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No heat intolerance, excessive thirst or excessive urination</td></tr></tbody></table><paragraph>12 systems reviewed. [S]</paragraph></text>

