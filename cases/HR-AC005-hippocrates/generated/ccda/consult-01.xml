    <title>Medications</title>
    <text><table><thead><tr><th>Medication</th><th>Frequency</th><th>Route</th><th>Dates</th><th>Status</th><th>Evidence</th></tr></thead><tbody><tr ID="medication-1"><td>Naproxen sodium 220 mg oral tablet, one or two tablets most days for knee pain, bought over the counter, for about two years; stopped at intake (Beers 2023: avoid chronic use)</td><td>One or two tablets by mouth up to twice a day, self-directed</td><td>Oral route</td><td>2024-03-01 to 2026-03-02</td><td>stopped</td><td>S</td></tr><tr ID="medication-2"><td>Diphenhydramine 25 mg oral capsule at bedtime three or four nights a week for sleep, bought over the counter; stopped at intake (Beers 2023: strongly anticholinergic)</td><td>One capsule at bedtime as needed, self-directed</td><td>Oral route</td><td>2025-09-01 to 2026-03-02</td><td>stopped</td><td>S</td></tr><tr ID="medication-3"><td>Acetaminophen 500 mg oral tablet, one or two tablets up to three times a day as needed for knee pain, no more than 3,000 mg in a day</td><td>One to two tablets by mouth every eight hours as needed; no more than six tablets a day</td><td>Oral route</td><td>2026-03-02</td><td>active</td><td>S</td></tr><tr ID="medication-4"><td>Vitamin D3 (cholecalciferol) 25 micrograms (1,000 units) oral tablet once daily</td><td>One tablet by mouth daily</td><td>Oral route</td><td>2026-03-02</td><td>active</td><td>S</td></tr><tr ID="medication-5"><td>Diclofenac 1% gel, 4 g rubbed into each painful knee up to four times a day</td><td>Apply 4 g to each painful knee up to four times a day</td><td>Topical route</td><td>2026-03-16</td><td>active</td><td>S</td></tr></tbody></table></text>

