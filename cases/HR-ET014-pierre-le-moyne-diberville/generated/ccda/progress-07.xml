    <title>Medications</title>
    <text><table><thead><tr><th>Medication</th><th>Frequency</th><th>Route</th><th>Dates</th><th>Status</th><th>Evidence</th></tr></thead><tbody><tr ID="medication-1"><td>Chloroquine phosphate 500 mg tablet: 1,000 mg (two tablets) at once, then 500 mg at 6, 24 and 48 hours; take with food</td><td>1,000 mg, then 500 mg at 6, 24 and 48 hours (2,500 mg salt in total)</td><td>Oral route</td><td>2026-03-03 to 2026-03-05</td><td>completed</td><td>S</td></tr><tr ID="medication-2"><td>Primaquine phosphate 26.3 mg tablet (15 mg base): two tablets (30 mg base) by mouth daily with food for 14 days</td><td>30 mg base once daily for 14 days</td><td>Oral route</td><td>2026-03-03 to 2026-03-16</td><td>completed</td><td>S</td></tr><tr ID="medication-3"><td>Atovaquone-proguanil 250 mg/100 mg tablet: one tablet daily with food, starting one to two days before entering a malaria area, daily there, and for seven days after leaving</td><td>once daily from 1 to 2 days before until 7 days after the malaria areas</td><td>Oral route</td><td>2026-10-13</td><td>on-hold</td><td>S</td></tr><tr ID="medication-4"><td>Azithromycin 500 mg tablet: one tablet daily for up to three days for severe travelers&apos; diarrhea (standby supply)</td><td>once daily for up to 3 days if needed</td><td>Oral route</td><td>2026-10-13</td><td>on-hold</td><td>S</td></tr><tr ID="medication-5"><td>Primaquine phosphate 26.3 mg tablet (15 mg base): two tablets (30 mg base) daily with food for 14 days, starting when he leaves the malaria areas (terminal prophylaxis)</td><td>30 mg base once daily for 14 days after leaving the malaria areas</td><td>Oral route</td><td>2026-10-13</td><td>on-hold</td><td>S</td></tr></tbody></table></text>

