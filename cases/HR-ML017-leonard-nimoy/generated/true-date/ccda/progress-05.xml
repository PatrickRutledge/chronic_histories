    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; no fever, night sweats, or unusual fatigue</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision with reading glasses</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Some difficulty hearing in noisy rooms; no sore mouth, hoarseness, or dry mouth from the inhaler</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, orthopnea, or ankle swelling</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Known breathlessness on longer walks and stairs; little cough and a small amount of clear morning sputum; no wheeze at rest</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No heartburn, swallowing trouble, or change in bowel habit</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No difficulty passing urine or retention since starting the inhaler</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No joint pain, back pain, or fractures</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No new or changing skin lesions</td></tr><tr><td>Neurological</td><td>Negative</td><td>No weakness, numbness, or memory change</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; no anxiety about breathing; PHQ-2 score 0</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No heat or cold intolerance, thirst, or frequent urination</td></tr><tr><td>Hematologic</td><td>Negative</td><td>No easy bruising or bleeding</td></tr></tbody></table><paragraph>13 systems reviewed. [S]</paragraph></text>

  </section>
</component>

