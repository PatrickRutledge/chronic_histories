    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Feels warm and tired</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Sore throat, runny and blocked nose; no ear or facial pain</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Dry cough; no shortness of breath or wheeze</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain or palpitations</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Persecutory fears easing; sleeping five hours; no thoughts of suicide or of harming anyone</td></tr></tbody></table><paragraph>5 systems reviewed. [S]</paragraph></text>

  </section>
</component>

