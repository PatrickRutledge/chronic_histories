    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever, weight loss or night sweats</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>Cold resolved</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Usual breathlessness after a block; a little clear morning sputum; no wheeze</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations or ankle swelling</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No indigestion or change in bowel habit</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No hesitancy or poor stream on the inhaler</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No muscle aches on atorvastatin; old shoulder and arm stiffness only</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No rashes</td></tr><tr><td>Neurological</td><td>Negative</td><td>No numbness, weakness or memory trouble</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 0</td></tr></tbody></table><paragraph>11 systems reviewed. [S]</paragraph></text>

  </section>
</component>

