    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Mild tiredness; temperature to 37.9 °C; appetite normal</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Sore throat, clear nasal discharge, and congestion; no ear or facial pain</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Dry cough; no breathlessness, wheeze, or sputum</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea, vomiting, abdominal pain, or diarrhea; mild constipation since amitriptyline was raised</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, or fainting</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headache or dizziness; mild morning drowsiness on amitriptyline</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
