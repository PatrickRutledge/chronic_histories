    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; no fever, night sweats, or unusual fatigue</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision with reading glasses</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No hearing change; no jaw pain, loose teeth, or mouth sores</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, or ankle swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No abdominal pain, swallowing difficulty, or change in bowel habit</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No urinary symptoms; no postmenopausal bleeding</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No bone, back, hip, or thigh pain; no new fracture</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No new or changing skin lesions</td></tr><tr><td>Neurological</td><td>Negative</td><td>No dizziness, weakness, or numbness</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; no cravings; PHQ-2 score 0</td></tr><tr><td>Breast</td><td>Negative</td><td>No lump, pain, or nipple discharge</td></tr></tbody></table><paragraph>12 systems reviewed. [S]</paragraph></text>

