    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fatigue, fever, or weight loss</td></tr><tr><td>Endocrine</td><td>Positive</td><td>Mild hot flashes</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain or leg swelling or pain</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No bone pain</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 score 0</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

