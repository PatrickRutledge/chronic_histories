    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fatigue or weight loss</td></tr><tr><td>Endocrine</td><td>Positive</td><td>Mild hot flashes</td></tr><tr><td>Genitourinary</td><td>Positive</td><td>Lower libido; erections adequate; no urinary symptoms</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain or leg swelling or pain</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 score 1</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

