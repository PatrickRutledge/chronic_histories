    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; no fatigue, fever, or night sweats</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision on tamoxifen</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No hearing loss or mouth problems</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, or leg swelling or pain</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No change in bowel habit or bleeding</td></tr><tr><td>Genitourinary</td><td>Positive</td><td>Lower libido on tamoxifen, not bothersome; no urinary symptoms or blood in the urine</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No bone or joint pain; full shoulder movement</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No new lump or skin change on the chest wall; no new skin lesions</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headache, weakness, or numbness</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 score 0</td></tr><tr><td>Endocrine</td><td>Positive</td><td>Mild hot flashes two or three times a week on tamoxifen</td></tr><tr><td>Hematologic and lymphatic</td><td>Negative</td><td>No arm swelling, easy bruising, or enlarged glands</td></tr></tbody></table><paragraph>13 systems reviewed. [S]</paragraph></text>

  </section>
</component>

