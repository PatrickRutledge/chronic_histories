    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; no fatigue on propranolol, fever, or night sweats</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision with reading glasses; no eye pain</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Mild voice tremor on sustained notes, eased by the voice-therapy techniques; no hoarseness or trouble swallowing</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, lightheadedness on standing, or ankle swelling; no cold hands</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No wheeze, cough, or breathlessness on propranolol</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No change in bowel habit or bleeding</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No urinary symptoms</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No joint pain or falls</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No new or changing skin lesions</td></tr><tr><td>Neurological</td><td>Positive</td><td>Known head and hand tremor, hands better on propranolol; no slowness, stiffness, imbalance, or numbness</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 score 0</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No heat intolerance, thirst, or frequent urination</td></tr><tr><td>Hematologic</td><td>Negative</td><td>No easy bruising or bleeding</td></tr></tbody></table><paragraph>13 systems reviewed. [S]</paragraph></text>

  </section>
</component>

