    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No weight loss, fever, or night sweats</td></tr><tr><td>Breast</td><td>Positive</td><td>Right breast lump with a dull ache; no nipple discharge or skin change</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No bone pain</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headaches</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Worried and sleeping less since the diagnosis; PHQ-9 5, GAD-7 7</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
</component>

