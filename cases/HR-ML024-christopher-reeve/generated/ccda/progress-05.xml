    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever, sweats, or weight change</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No bleeding or granulation tissue at the tracheostomy</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No pounding headaches, flushing, or episodes of high blood pressure; no leg swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>Secretions thin and clear; no change in suction needs</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Bowel program effective each morning; no accidents</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>Urine clear; no blockages or bypassing</td></tr><tr><td>Musculoskeletal</td><td>Positive</td><td>Occasional neck and shoulder aching</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No redness over the sacrum, hips, heels or shoulder blades</td></tr><tr><td>Neurological</td><td>Negative</td><td>No new weakness or loss of sensation; spasms mild</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 0</td></tr></tbody></table><paragraph>11 systems reviewed. [S]</paragraph></text>

