    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Low fever and aches at night</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Cough with clear sputum; no breathlessness at rest</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain or palpitations</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Mild sore throat and runny nose</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>No thoughts of suicide; sleep disturbed by the cough</td></tr></tbody></table><paragraph>5 systems reviewed. [S]</paragraph></text>

  </section>
