    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Low-grade warmth and tiredness; no rigors</td></tr><tr><td>Gastrointestinal</td><td>Positive</td><td>Nausea, vomiting now settled, and watery diarrhea without blood or severe pain</td></tr><tr><td>Genitourinary</td><td>Positive</td><td>Passing less urine than usual, darker in color</td></tr><tr><td>Neurological</td><td>Negative</td><td>No seizure, warning symptoms, headache, dizziness, double vision, or unsteadiness</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No rash, blistering, or mouth sores</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Worried about a seizure; no thoughts of suicide; no gambling</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
</component>

