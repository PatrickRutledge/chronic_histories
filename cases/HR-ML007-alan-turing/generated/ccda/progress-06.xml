    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Breast</td><td>Negative</td><td>No tenderness or discharge</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>Libido and erections normal</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>Ankle recovered</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; no suicidal thoughts, elevated mood, or racing thoughts</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

