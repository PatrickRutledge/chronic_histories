    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever, night sweats, or weight loss</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision or color perception</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>Hearing normal on both sides; the healed left ear causes no pain</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain or palpitations</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No abdominal pain, nausea from naltrexone, or change in bowels</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No urinary symptoms; no sexual side effects</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No joint pain</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No changing moles; sunburn on the neck at times</td></tr><tr><td>Neurological</td><td>Negative</td><td>No restlessness, stiffness, tremor, or abnormal movements; no seizures or episodes of confusion</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-9 score 4; no voices or suspiciousness; no thoughts of suicide or self-harm</td></tr></tbody></table><paragraph>11 systems reviewed. [S]</paragraph></text>

  </section>
</component>

