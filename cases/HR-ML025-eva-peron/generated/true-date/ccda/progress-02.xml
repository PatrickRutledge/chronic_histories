    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Tired; no fever or weight loss</td></tr><tr><td>Genitourinary</td><td>Positive</td><td>Lighter bleeding; no urinary symptoms or blood in the urine</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Dark stools on iron; no rectal bleeding or pain on opening the bowels</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No back or leg pain; no leg swelling</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Shocked and frightened by the news; no thoughts of self-harm</td></tr></tbody></table><paragraph>5 systems reviewed. [S]</paragraph></text>

  </section>
</component>

