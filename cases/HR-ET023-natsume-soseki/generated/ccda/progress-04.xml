    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever, chills or weight loss</td></tr><tr><td>Musculoskeletal</td><td>Positive</td><td>Low back ache with stiffness; no other joint pain</td></tr><tr><td>Neurological</td><td>Negative</td><td>No numbness, weakness, or saddle anesthesia</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No difficulty passing urine</td></tr><tr><td>Gastrointestinal</td><td>Positive</td><td>Slightly loose stools once a day and a metallic taste on treatment; dark formed stools on iron; no epigastric pain, vomiting or blood</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No rash</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
