    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; tiredness at the end of a long day only</td></tr><tr><td>Eyes</td><td>Negative</td><td>No vision change</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No further nosebleeds; hearing normal</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No palpitations, chest pain or swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No black stools or swallowing difficulty</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No blood in the urine</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No falls; mild stiffness of the knees</td></tr><tr><td>Integumentary</td><td>Negative</td><td>Occasional small bruises on the forearms</td></tr><tr><td>Neurological</td><td>Negative</td><td>No weakness, numbness, speech or vision change; right hand normal at the piano</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood steady; PHQ-2 score 0</td></tr><tr><td>Hematologic</td><td>Negative</td><td>No bleeding gums</td></tr></tbody></table><paragraph>12 systems reviewed. [S]</paragraph></text>

