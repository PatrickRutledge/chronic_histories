    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Appetite better; weight 53.4 kg</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea, diarrhea, or bleeding</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No falls; shoulder ache settled</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Mood lighter but not yet back to her usual; no suicidal thoughts, elevated mood, or agitation</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

