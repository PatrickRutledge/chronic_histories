    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Neurological</td><td>Positive</td><td>Forgetfulness, better when rested; no headaches, weakness or tremor</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Nightmares four or five nights a week; less guilt; mood better; no thoughts of suicide</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea or diarrhea</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No falls</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

