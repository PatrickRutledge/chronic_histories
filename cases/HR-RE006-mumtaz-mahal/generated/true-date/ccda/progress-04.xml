    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever or chills</td></tr><tr><td>Genitourinary</td><td>Positive</td><td>Dysuria, frequency, and urgency; no blood seen; no vaginal discharge, bleeding, or leaking fluid</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea, vomiting, or diarrhea</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No back or flank pain</td></tr><tr><td>Obstetric</td><td>Negative</td><td>No contractions; fetal movements normal</td></tr></tbody></table><paragraph>5 systems reviewed. [S]</paragraph></text>

  </section>
