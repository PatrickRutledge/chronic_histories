    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Tired by late afternoon; weight up 0.8 kg</td></tr><tr><td>Cardiovascular</td><td>Positive</td><td>Brief lightheadedness on standing quickly; no fainting or palpitations</td></tr><tr><td>Gastrointestinal</td><td>Positive</td><td>Salt craving; no nausea, vomiting, or abdominal pain</td></tr><tr><td>Musculoskeletal</td><td>Positive</td><td>Low back ache after long sitting; no leg pain</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No cold intolerance, constipation, or dry skin</td></tr></tbody></table><paragraph>5 systems reviewed. [S]</paragraph></text>

  </section>
</component>

