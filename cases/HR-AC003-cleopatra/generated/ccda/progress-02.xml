    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Tired</td></tr><tr><td>Gastrointestinal</td><td>Positive</td><td>Nausea, easing; vomiting about once a day</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No bleeding, discharge, or urinary symptoms</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Surprised and pleased; some worry about work</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
