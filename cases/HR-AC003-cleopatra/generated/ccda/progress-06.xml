    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Well; tired by evening</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No breathlessness or palpitations</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headache or visual change</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No upper abdominal pain; mild heartburn</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No bleeding, leaking fluid, or urinary symptoms</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Calm and looking forward; EPDS 6</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

