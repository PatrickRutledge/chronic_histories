    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Respiratory</td><td>Positive</td><td>Occasional cough; no blood for twelve days</td></tr><tr><td>Constitutional</td><td>Negative</td><td>No fever or night sweats; appetite returning</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Nausea gone; no abdominal pain or jaundice</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No tendon or joint pain</td></tr><tr><td>Neurological</td><td>Negative</td><td>No numbness or tingling</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood better; no thoughts of suicide or self-harm</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
</component>

