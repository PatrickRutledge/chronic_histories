    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Low-grade temperature; no night sweats or weight loss</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Sore throat, runny and blocked nose; no ear pain</td></tr><tr><td>Respiratory</td><td>Positive</td><td>Mild dry cough for two days; no blood, breathlessness, or chest pain</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea, abdominal pain, or jaundice</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No tendon or joint pain</td></tr><tr><td>Neurological</td><td>Negative</td><td>No numbness or tingling in his fingers or feet</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
