    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Energy back to normal; weight up; no fever</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>Clear urine; no flank pain</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No stomach upset on bicarbonate; no change in bowel habit or bleeding</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No bone pain</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; PHQ-2 score 0</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
</component>

