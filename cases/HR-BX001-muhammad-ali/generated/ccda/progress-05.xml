    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>Weight stable; no fever, night sweats, or fatigue beyond his usual</td></tr><tr><td>Eyes</td><td>Negative</td><td>No eye pain or double vision</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No hearing loss, drooling, or trouble chewing or swallowing</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, lightheadedness on standing, or ankle swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness; no choking with meals</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No constipation, nausea, heartburn, or blood in the stool</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No urinary urgency or nighttime urination beyond once</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No joint or back pain</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No new or changing skin lesions</td></tr><tr><td>Neurological</td><td>Positive</td><td>Known tremor and slowness, better since the levodopa increase; no freezing, dyskinesia, or wearing-off</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; no anxiety, hallucinations, or impulse-control problems; PHQ-2 score 0</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No heat or cold intolerance, thirst, or frequent urination</td></tr><tr><td>Hematologic</td><td>Negative</td><td>No easy bruising or bleeding</td></tr></tbody></table><paragraph>13 systems reviewed. [S]</paragraph></text>

  </section>
</component>

