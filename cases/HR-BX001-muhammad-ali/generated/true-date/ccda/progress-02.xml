    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Cardiovascular</td><td>Negative</td><td>No lightheadedness on standing or fainting</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea, constipation, or trouble swallowing</td></tr><tr><td>Neurological</td><td>Positive</td><td>Slowness of movement and mild right-hand tremor; no freezing or involuntary movements</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; no hallucinations or impulse-control problems</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Positive</td><td>Soft voice, hard to hear in noisy places; no drooling</td></tr></tbody></table><paragraph>5 systems reviewed. [S]</paragraph></text>

  </section>
</component>

