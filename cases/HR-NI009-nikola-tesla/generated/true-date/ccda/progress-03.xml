    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea or diarrhea</td></tr><tr><td>Integumentary</td><td>Positive</td><td>Hands still dry; no open cracks</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Counting and repeating persist; mood a little better; no suicidal thoughts</td></tr></tbody></table><paragraph>3 systems reviewed. [S]</paragraph></text>

  </section>
</component>

