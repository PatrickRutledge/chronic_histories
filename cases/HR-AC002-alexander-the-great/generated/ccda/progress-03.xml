    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Integumentary</td><td>Positive</td><td>Cut on the left forearm</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>Wrist and fingers move normally</td></tr><tr><td>Neurological</td><td>Negative</td><td>No numbness or tingling in the hand</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>No thoughts of self-harm</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

