    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever; energy back to normal</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough, wheeze, or night waking now; breathless only on steep hills</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No difficulty passing urine</td></tr><tr><td>Eyes</td><td>Negative</td><td>No eye pain or blurred vision</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

