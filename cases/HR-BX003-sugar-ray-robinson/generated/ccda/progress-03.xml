    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Neurological</td><td>Positive</td><td>Memory loss unchanged; no falls</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Sad at the news but not depressed; no thoughts of self-harm</td></tr><tr><td>Endocrine</td><td>Positive</td><td>One low glucose reading before lunch, with sweating</td></tr></tbody></table><paragraph>3 systems reviewed. [S]</paragraph></text>

  </section>
</component>

