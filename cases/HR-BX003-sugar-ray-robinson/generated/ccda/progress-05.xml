    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Gastrointestinal</td><td>Negative</td><td>No nausea, diarrhea or weight loss</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No dizziness or fainting</td></tr><tr><td>Neurological</td><td>Positive</td><td>Memory loss unchanged; no falls</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; enjoys the day program</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

