    <code code="10160-0" codeSystem="2.16.840.1.113883.6.1" displayName="History of Medication use Narrative"/>
    <title>Medications</title>
    <text><table><thead><tr><th>Medication</th><th>Frequency</th><th>Route</th><th>Dates</th><th>Status</th><th>Evidence</th></tr></thead><tbody><tr ID="medication-1"><td>Pembrolizumab 200 mg intravenous infusion over 30 minutes every 3 weeks</td><td>Every 3 weeks in the oncology infusion unit, after the immune-related adverse event laboratory panel</td><td>Intravenous route</td><td>2026-09-22</td><td>active</td><td>S</td></tr><tr ID="medication-2"><td>Zoledronic acid 4 mg in 100 mL intravenous infusion over 15 minutes every 12 weeks, for bone metastases</td><td>Every 12 weeks, after calcium and creatinine, with a dental examination done first</td><td>Intravenous route</td><td>2026-10-13</td><td>active</td><td>S</td></tr><tr ID="medication-3"><td>Cholecalciferol (vitamin D3) 25 mcg (1000 units) oral tablet, one tablet daily, with calcium from food, while on zoledronic acid</td><td>One tablet by mouth daily</td><td>Oral route</td><td>2026-10-13</td><td>active</td><td>S</td></tr><tr ID="medication-4"><td>Triamcinolone acetonide 0.1% cream, thin layer to the rash twice daily for two weeks (not on the face or skin folds)</td><td>Apply a thin layer twice daily for up to two weeks</td><td>Topical route</td><td>2026-10-20</td><td>active</td><td>S</td></tr><tr ID="medication-5"><td>Cetirizine 10 mg oral tablet, one tablet daily as needed for itching</td><td>One tablet by mouth daily as needed for itching</td><td>Oral route</td><td>2026-10-20</td><td>active</td><td>S</td></tr></tbody></table></text>

