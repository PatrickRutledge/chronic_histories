    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations or ankle swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No breathlessness</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headache or visual change</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood good; looking forward to the command</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
</component>

