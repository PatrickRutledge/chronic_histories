    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever, weight change, or night sweats</td></tr><tr><td>Eyes</td><td>Negative</td><td>No vision change</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>No hearing change or sore throat</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No chest pain, palpitations, or leg swelling</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No painful bowel movements since the periods stopped; no bleeding</td></tr><tr><td>Genitourinary</td><td>Positive</td><td>Deep pain with intercourse; no periods, two days of light spotting; no urinary symptoms since the infection cleared</td></tr><tr><td>Musculoskeletal</td><td>Negative</td><td>No joint pain</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No changing moles or rash</td></tr><tr><td>Neurological</td><td>Negative</td><td>No headaches, migraine, or visual aura on the pill</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No heat or cold intolerance</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Mood improving; PHQ-9 score 8; no thoughts of suicide or self-harm</td></tr></tbody></table><paragraph>12 systems reviewed. [S]</paragraph></text>

  </section>
</component>

