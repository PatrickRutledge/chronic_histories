    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Positive</td><td>Fatigue at her improved baseline; no fever, night sweats, or weight loss</td></tr><tr><td>Eyes</td><td>Negative</td><td>No change in vision</td></tr><tr><td>Ears, nose, mouth, and throat</td><td>Negative</td><td>Cold resolved; no hearing change</td></tr><tr><td>Cardiovascular</td><td>Positive</td><td>Mild lightheadedness on standing two or three times a week; no chest pain or syncope</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>Regular bowel habit; no pain or bleeding</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>Regular periods; no abnormal bleeding, discharge, or urinary symptoms</td></tr><tr><td>Musculoskeletal</td><td>Positive</td><td>Occasional diffuse muscle aches; no back pain, joint pain, or swelling</td></tr><tr><td>Integumentary</td><td>Negative</td><td>No new or changing skin lesions</td></tr><tr><td>Neurological</td><td>Positive</td><td>Occasional word-finding difficulty when tired; no weakness or numbness</td></tr><tr><td>Psychiatric</td><td>Negative</td><td>Mood steady; PHQ-9 score 4 with item 9 scored 0; GAD-7 score 3</td></tr><tr><td>Endocrine</td><td>Negative</td><td>No heat or cold intolerance, polyuria, or polydipsia</td></tr><tr><td>Hematologic</td><td>Negative</td><td>No easy bruising or bleeding</td></tr></tbody></table><paragraph>13 systems reviewed. [S]</paragraph></text>

  </section>
</component>

