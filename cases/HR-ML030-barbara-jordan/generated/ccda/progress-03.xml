    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever or infection</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>Urgency better; no burning</td></tr><tr><td>Musculoskeletal</td><td>Positive</td><td>Mild morning stiffness</td></tr><tr><td>Neurological</td><td>Negative</td><td>No new numbness, weakness or visual change</td></tr></tbody></table><paragraph>4 systems reviewed. [S]</paragraph></text>

  </section>
