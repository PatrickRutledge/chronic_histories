    <code code="10187-3" codeSystem="2.16.840.1.113883.6.1" displayName="Review of systems Narrative - Reported"/>
    <title>Review of Systems</title>
    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Musculoskeletal</td><td>Positive</td><td>Right lower back pain with movement; no other joint pain</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No abdominal pain, nausea, vomiting, or change in bowel habit</td></tr><tr><td>Cardiovascular</td><td>Negative</td><td>No fainting, lightheadedness, chest pain, or cold or painful legs</td></tr><tr><td>Genitourinary</td><td>Negative</td><td>No flank pain, blood in the urine, retention, or incontinence</td></tr><tr><td>Neurological</td><td>Negative</td><td>No numbness, tingling, or weakness in the legs; no saddle numbness</td></tr><tr><td>Constitutional</td><td>Negative</td><td>No fever, chills, or weight loss</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
</component>

