    <text><table><thead><tr><th>System</th><th>Result</th><th>Finding</th></tr></thead><tbody><tr><td>Constitutional</td><td>Negative</td><td>No fever or chills; tired from broken sleep</td></tr><tr><td>Eyes</td><td>Negative</td><td>No eyelid swelling or eye irritation</td></tr><tr><td>Respiratory</td><td>Negative</td><td>No cough, wheeze, or breathlessness</td></tr><tr><td>Gastrointestinal</td><td>Negative</td><td>No heartburn, abdominal pain, or black stools; no past ulcer</td></tr><tr><td>Integumentary</td><td>Positive</td><td>Itchy blistering rash on the arms, hands, neck, and shins; no pus or spreading redness</td></tr><tr><td>Psychiatric</td><td>Positive</td><td>Sleep broken by itch for two nights; mood steady; no suicidal thoughts, elevated mood, or racing thoughts</td></tr></tbody></table><paragraph>6 systems reviewed. [S]</paragraph></text>

  </section>
</component>

