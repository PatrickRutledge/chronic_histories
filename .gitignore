.work/

# Generated review images and inspection logs
outputs/**/*.png
outputs/**/*.inspect.ndjson

# Full conformance reports are local; only the summary is tracked
pilots/**/generated/conformance/*
!pilots/**/generated/conformance/summary.json

# Local validation and editor artifacts
*.tmp
*.log
.DS_Store
Thumbs.db

# Test fixtures are regenerated on demand
tests/**/generated/

# Reviewable copy written by scripts/sync_workbook_registers.py
outputs/**/*.synced.xlsx
